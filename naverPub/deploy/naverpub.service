[Unit]
Description=naverPub daily content (oneshot)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=naverpub
WorkingDirectory=/opt/naverPub
Environment=TZ=Asia/Seoul
EnvironmentFile=/opt/naverPub/.env
ExecStart=/opt/naverPub/.venv/bin/python /opt/naverPub/runner.py
Nice=10

[Install]
WantedBy=multi-user.target
